<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="application.Controllers.LobbyController"
            prefWidth="1000" prefHeight="750"
            styleClass="root" stylesheets="@../css/lobby.css">

    <top>
    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20;">
        <VBox>
            <Text text="GAME LOBBY" styleClass="title-text"/>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Text text="Logged as: " style="-fx-fill: #888888; -fx-font-size: 12;"/>
                <Label fx:id="currentNameLabel" text="Guest" style="-fx-text-fill: #304ffe; -fx-font-weight: bold; -fx-font-size: 14;"/>
            </HBox>
        </VBox>
        
        <Region HBox.hgrow="ALWAYS" />
        
        <HBox alignment="CENTER" spacing="10" styleClass="glass-panel">
            <TextField fx:id="nameField" promptText="Enter new name..." />
            <Button text="Update Name" onAction="#handleUpdateName" styleClass="button-primary"/>
        </HBox>
    </HBox>
	</top>

    <left>
    	<VBox spacing="15" prefWidth="300" style="-fx-padding: 0 0 20 20;">
        	<HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Connected Players" style="-fx-text-fill: white; -fx-font-size: 16;"/>
            <Region HBox.hgrow="ALWAYS" /> <Button text="↻" onAction="#handleRefreshPlayers" styleClass="button-refresh"/>
        	</HBox>
        
        	<VBox fx:id="playersList" spacing="10" VBox.vgrow="ALWAYS" styleClass="glass-panel"/>
    	</VBox>
	</left>

    <center>
        <VBox spacing="20" style="-fx-padding: 0 20 20 20;">
            <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="glass-panel">
                <Label text="Incoming Requests" style="-fx-text-fill: white; -fx-font-size: 16;"/>
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                    <VBox fx:id="incomingRequests" spacing="10" />
                </ScrollPane>
            </VBox>

            <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="glass-panel">
                <Label text="Sent Requests" style="-fx-text-fill: white; -fx-font-size: 16;"/>
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                    <VBox fx:id="sentRequests" spacing="10" />
                </ScrollPane>
            </VBox>
        </VBox>
    </center>

</BorderPane>